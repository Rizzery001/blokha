# ---- apps/server ----
# Порт HTTP + WebSocket сервера (в проде задаётся в docker-compose)
PORT=3001
# Пауза между действиями робота в онлайн-комнате, мс
BOT_DELAY_MS=1100

# ---- apps/web (Vite читает только VITE_*) ----
# Адрес сервера комнат. Пусто = тот же origin, с которого открыт сайт
# (в продакшене сервер сам раздаёт собранный web-клиент, так что переменная не нужна).
# В dev vite проксирует /socket.io на http://localhost:3001.
VITE_SERVER_URL=
