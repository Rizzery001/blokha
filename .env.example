# ---- apps/server ----
# Порт HTTP + WebSocket сервера (в проде задаётся в docker-compose)
PORT=3001
# Пауза между действиями робота в онлайн-комнате, мс
BOT_DELAY_MS=1100

# ---- apps/web (Vite читает только VITE_*) ----
# Адрес сервера комнат. Пусто = тот же origin, с которого открыт сайт
# (в продакшене сервер сам раздаёт собранный web-клиент, так что переменная не нужна).
# В dev vite проксирует /socket.io на http://localhost:3001.
VITE_SERVER_URL=

# ---- аккаунты, друзья, платежи (Telegram) ----
# Токен бота от @BotFather. Без него работают только гостевой режим и локальные профили.
TELEGRAM_BOT_TOKEN=
# Username бота без @ (для кнопки входа на сайте)
TELEGRAM_BOT_USERNAME=
# Адрес игры для кнопки «Играть» в /start и Mini App
WEB_APP_URL=https://blokha-104-248-243-31.sslip.io
# Каталог базы SQLite (аккаунты, друзья, покупки)
DATA_DIR=./data
# Опрос Telegram Bot API внутри сервера (платежи Stars, /start); 0 — выключить
TELEGRAM_POLLING=1
# Вход по имени без Telegram — только для разработки и тестов
DEV_LOGIN=0
